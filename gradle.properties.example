# Add ONE provider block to Develop/gradle.properties, your user Gradle properties,
# or environment variables. Preserve the existing Android build settings.

# Qwen (Alibaba Cloud Model Studio, Beijing-region API key).
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
LLM_SENTENCE_MODEL=qwen3.8-flash
LLM_GENERAL_MODEL=qwen3.8-flash

# DeepSeek alternative: replace the five lines above; do not append duplicate keys.
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_API_BASE_URL=https://api.deepseek.com/
# LLM_SENTENCE_MODEL=deepseek-flash
# LLM_GENERAL_MODEL=deepseek-flash

# Qwen and DeepSeek reasoning is disabled for short communication requests.
# For Qwen's newer workspace endpoint, replace the base URL with the one in your console.
# Keep the /compatible-mode/v1/ path and use an API key from the same region.

# Speech uses the phone's TTS engine and selected app language, without an API key.
TTS_PROVIDER=system

# Optional legacy services (not required for Qwen/DeepSeek).
MY_GEMINI_KEY=
MY_OPENAI_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Legacy OpenAI: provider=openai, base=https://api.openai.com/v1/,
# model=gpt-4o-mini. MY_OPENAI_KEY is used if LLM_API_KEY is empty.
# Optional OpenAI speech: set TTS_PROVIDER=openai and MY_OPENAI_KEY separately.
